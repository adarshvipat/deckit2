# Copy to .env and fill in real values. Never commit .env.

# Required for caption → event conversion
OPENROUTER_API_KEY=sk-asdfsasdfasdf
                   
# Optional model override (OpenRouter model id)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: show your app on openrouter.ai rankings
# OPENROUTER_HTTP_REFERER=https://localhost
# OPENROUTER_APP_TITLE=instagram-caption-scraper

# Optional Instagram login (dedicated scraper account recommended)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
